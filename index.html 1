      box-shadow: 0 0 10px #20df9f;
    }

    /* الجوال الصغير */
    @media(max-width:390px) {
      .container {
        padding: 13px 11px 25px;
      }

      .logo {
        width: 110px;
        height: 110px;
      }

      .hero h1 {
        font-size: 24px;
      }
    }
  </style>
