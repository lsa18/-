<body>

<div class="container">

  <!-- الأعلى -->
  <div class="top">
    <div class="dots">•••</div>
    <div class="code">&lt;/&gt;</div>
  </div>

  <!-- الشعار -->
  <div class="logo">
    <div class="crown">♛</div>
  </div>

  <div class="badge">
    ✦ نسخة خاصة • PRIVATE EDITION
  </div>

  <!-- الترحيب -->
  <div class="hero">
    <h1>
      مرحباً بك<br>
      <span>عسعوسي</span>
    </h1>

    <p>
      البوت الخاص بك • محلل Smarty الخاص
    </p>
  </div>

  <!-- البطاقة الرئيسية -->
  <div class="card">

    <div class="title">
      أدخل الرمز الخاص بك
    </div>

    <div class="input-box">
      <div class="icon">🔑</div>

      <input
        id="token"
        type="text"
        placeholder="أدخل الرمز الخاص"
      >
    </div>

    <button
      class="login"
      onclick="activate()"
    >
      🔒 تفعيل البوت الخاص - دخول
    </button>

    <!-- الأوضاع -->
    <div class="modes">

      <button
        class="mode"
        onclick="mode(this,'EN')"
      >
        ✦<br>
        EN
      </button>

      <button
        class="mode active"
        onclick="mode(this,'الكامل')"
      >
        ✦<br>
        الكامل
      </button>

      <button
        class="mode"
        onclick="mode(this,'الأساسي')"
      >
        ♛<br>
        الأساسي
      </button>

    </div>

    <!-- الإحصائيات -->
    <div class="stats">

      <div class="stat">
        <div class="number">68</div>
        <div class="small">سوق</div>
      </div>

      <div class="stat">
        <div class="number green">Smarty</div>
        <div class="small">محلل خاص</div>
      </div>

      <div class="stat">
        <div class="number">∞</div>
        <div class="small">مدى الحياة</div>
      </div>

    </div>

    <!-- المعلومات -->
