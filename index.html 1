      color: #2ee4ac;
      font-size: 21px;
    }

    /* الحالة */
    .status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;

      margin-top: 10px;
      color: #31e3ac;
      font-size: 11px;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
