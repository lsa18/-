<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>عسعوسي | بوت Expert Option</title>
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:Tahoma,Arial,sans-serif;background:linear-gradient(180deg,#06131e,#07101b);color:#eef7f5}
.container{width:min(100%,680px);margin:auto;padding:18px 14px 40px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
.logo{font-size:28px;font-weight:800;color:#00e09b}
.badge{border:1px solid #087f67;border-radius:30px;padding:8px 13px;color:#22e0ad;font-size:13px}
.card{background:#101d31;border:1px solid #19304a;border-radius:24px;padding:20px;margin:14px 0;box-shadow:0 10px 30px #0004}
h1,h2,h3{margin-top:0}
.center{text-align:center}
input,select{width:100%;padding:15px;border-radius:15px;border:1px solid #243c57;background:#071020;color:white;font-size:16px;margin:8px 0}
button{width:100%;border:0;border-radius:15px;padding:15px;font-size:16px;font-weight:bold;cursor:pointer;background:#00d99a;color:#03140f;margin-top:10px}
button.secondary{background:#17263b;color:#dffaf2;border:1px solid #29415b}
button.danger{background:#8e2530;color:white}
.hidden{display:none!important}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat{background:#071020;border-radius:18px;padding:16px;text-align:center}
.stat b{display:block;font-size:22px;color:#22dfae;margin-bottom:6px}
.row{display:flex;gap:10px;align-items:center}
.row>*{flex:1}
.tabs{display:flex;gap:8px;overflow:auto;margin-bottom:12px}
.tab{white-space:nowrap;padding:11px 14px;border-radius:14px;background:#101d31;color:#b9cbc8;border:1px solid #21364e}
.tab.active{background:#00c98f;color:#04150f}
.signal{border-radius:18px;padding:17px;background:#071020;border:1px solid #213b53;margin-top:12px}
.signal.up{border-color:#087c5f}.signal.down{border-color:#8b3944}
.signal .dir{font-size:25px;font-weight:bold}
.good{color:#22dfae}.bad{color:#ff7581}.muted{color:#8fa5a7}
.small{font-size:13px}
.list{display:grid;gap:9px}
.option{padding:14px;border-radius:15px;background:#071020;border:1px solid #21364e;cursor:pointer}
.option.selected{border-color:#00d99a;box-shadow:0 0 0 1px #00d99a inset}
.notice{padding:13px;border-radius:14px;background:#12243a;color:#bcd0ce;font-size:13px;line-height:1.7}
footer{text-align:center;color:#6f8589;font-size:12px;margin-top:25px}
</style>
</head>
<body>
<div class="container">

<header>
  <div class="logo">عسعوسي</div>
  <div class="badge">PRIVATE EDITION</div>
</header>

<section id="loginScreen">
  <div class="card center">
    <div style="font-size:70px">♛</div>
    <h1>مرحباً بك</h1>
    <p class="muted">البوت الخاص بك • محلل إشارات</p>
  </div>

  <div class="card">
    <h3>🔐 أدخل رمز الدخول</h3>
    <input id="codeInput" type="password" inputmode="numeric" placeholder="أدخل الرمز">
    <button onclick="login()">دخول وتفعيل البوت</button>
    <p id="loginMsg" class="bad center"></p>
  </div>
</section>

<section id="appScreen" class="hidden">
  <div class="card">
    <div class="row">
      <div>
        <h2 style="margin-bottom:4px">بوت عسعوسي</h2>
        <span class="small muted">لوحة التحليل والإشارات</span>
      </div>
      <button id="botBtn" onclick="toggleBot()">تشغيل البوت</button>
    </div>
    <div id="botStatus" class="notice" style="margin-top:12px">البوت متوقف — اختر السوق والاستراتيجية ثم شغّله.</div>
  </div>

  <div class="tabs">
    <button class="tab active" onclick="showTab('analysis',this)">التحليل</button>
    <button class="tab" onclick="showTab('markets',this)">الأسواق</button>
    <button class="tab" onclick="showTab('strategies',this)">الاستراتيجيات</button>
  </div>

  <section id="analysis" class="tabContent">
    <div class="card">
      <h3>📊 شاشة التحليل</h3>
      <div class="grid">
        <div class="stat"><b id="marketStat">EUR/USD</b><span class="small muted">السوق</span></div>
        <div class="stat"><b id="strategyStat">Trend</b><span class="small muted">الاستراتيجية</span></div>
        <div class="stat"><b id="timeStat">5 دقائق</b><span class="small muted">مدة التحليل</span></div>
        <div class="stat"><b id="confidence">--</b><span class="small muted">قوة الإشارة</span></div>
      </div>

      <div id="signalBox" class="signal center">
        <div class="muted">اضغط تشغيل البوت لبدء التحليل التجريبي</div>
      </div>
      <button class="secondary" onclick="generateSignal()">تحديث التحليل</button>
    </div>

    <div class="card">
      <h3>⏱️ مدة الصفقة</h3>
      <select id="duration" onchange="updateDuration()">
        <option value="1">1 دقيقة</option>
        <option value="5" selected>5 دقائق</option>
        <option value="10">10 دقائق</option>
        <option value="15">15 دقيقة</option>
      </select>
      <div class="notice">هذه الشاشة تعرض تحليلاً تجريبياً فقط. لا يتم تنفيذ صفقات حقيقية من هذا الملف.</div>
    </div>
  </section>

  <section id="markets" class="tabContent hidden">
    <div class="card">
      <h3>🌐 اختر السوق</h3>
      <div class="list">
        <div class="option selected" onclick="selectMarket('EUR/USD',this)">EUR/USD</div>
        <div class="option" onclick="selectMarket('GBP/USD',this)">GBP/USD</div>
        <div class="option" onclick="selectMarket('USD/JPY',this)">USD/JPY</div>
        <div class="option" onclick="selectMarket('AUD/USD',this)">AUD/USD</div>
        <div class="option" onclick="selectMarket('USD/CAD',this)">USD/CAD</div>
      </div>
    </div>
  </section>

  <section id="strategies" class="tabContent hidden">
    <div class="card">
      <h3>🧠 اختر الاستراتيجية</h3>
      <div class="list">
        <div class="option selected" onclick="selectStrategy('Trend',this)">
          <b>Trend</b><br><span class="small muted">اتجاه السوق</span>
        </div>
        <div class="option" onclick="selectStrategy('RSI',this)">
          <b>RSI</b><br><span class="small muted">تشبع شراء/بيع</span>
        </div>
        <div class="option" onclick="selectStrategy('EMA',this)">
          <b>EMA Cross</b><br><span class="small muted">تقاطع المتوسطات</span>
        </div>
        <div class="option" onclick="selectStrategy('Support/Resistance',this)">
          <b>دعم ومقاومة</b><br><span class="small muted">مناطق سعرية</span>
        </div>
      </div>
    </div>
  </section>

  <button class="danger" onclick="logout()">تسجيل الخروج</button>
</section>

<footer>عسعوسي © 2026</footer>
</div>

<script>
const SECRET_CODE = "2008";

let botRunning = false;
let selectedMarket = "EUR/USD";
let selectedStrategy = "Trend";

function login(){
  const code = document.getElementById("codeInput").value.trim();
  const msg = document.getElementById("loginMsg");

  if(code !== SECRET_CODE){
    msg.textContent = "رمز الدخول غير صحيح";
    return;
  }

  msg.textContent = "";
  document.getElementById("loginScreen").classList.add("hidden");
  document.getElementById("appScreen").classList.remove("hidden");
}

function logout(){
  botRunning = false;
  document.getElementById("appScreen").classList.add("hidden");
  document.getElementById("loginScreen").classList.remove("hidden");
  document.getElementById("codeInput").value = "";
  updateBotUI();
}

function toggleBot(){
  botRunning = !botRunning;
  updateBotUI();
  if(botRunning) generateSignal();
}

function updateBotUI(){
  const btn = document.getElementById("botBtn");
  const status = document.getElementById("botStatus");

  if(botRunning){
    btn.textContent = "إيقاف البوت";
    btn.className = "danger";
    status.textContent = "🟢 البوت يعمل — التحليل تجريبي ولا ينفذ صفقات حقيقية.";
  }else{
    btn.textContent = "تشغيل البوت";
    btn.className = "";
    status.textContent = "البوت متوقف — اختر السوق والاستراتيجية ثم شغّله.";
  }
}

function showTab(id,el){
  document.querySelectorAll(".tabContent").forEach(x=>x.classList.add("hidden"));
  document.getElementById(id).classList.remove("hidden");
  document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));
  el.classList.add("active");
}

function selectMarket(name,el){
  selectedMarket = name;
  document.querySelectorAll("#markets .option").forEach(x=>x.classList.remove("selected"));
  el.classList.add("selected");
  document.getElementById("marketStat").textContent = name;
  if(botRunning) generateSignal();
}

function selectStrategy(name,el){
  selectedStrategy = name;
  document.querySelectorAll("#strategies .option").forEach(x=>x.classList.remove("selected"));
  el.classList.add("selected");
  document.getElementById("strategyStat").textContent = name;
  if(botRunning) generateSignal();
}

function updateDuration(){
  document.getElementById("timeStat").textContent =
    document.getElementById("duration").value + " دقائق";
}

function generateSignal(){
  if(!botRunning){
    document.getElementById("signalBox").innerHTML =
      '<div class="muted">شغّل البوت أولاً لعرض التحليل.</div>';
    return;
  }

  const up = Math.random() >= 0.5;
  const confidence = Math.floor(65 + Math.random()*30);

  document.getElementById("confidence").textContent = confidence + "%";

  const box = document.getElementById("signalBox");
  box.className = "signal center " + (up ? "up" : "down");

  box.innerHTML = `
    <div class="dir ${up ? "good":"bad"}">${up ? "⬆️ CALL / صعود" : "⬇️ PUT / هبوط"}</div>
    <div style="margin-top:8px">${selectedMarket}</div>
    <div class="small muted" style="margin-top:7px">
      استراتيجية: ${selectedStrategy} • تحليل تجريبي
    </div>
  `;
}

document.getElementById("codeInput").addEventListener("keydown",e=>{
  if(e.key==="Enter") login();
});
</script>
</body>
</html>

