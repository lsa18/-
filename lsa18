<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expert Option Pro Bot 🤖</title>
    <style>
        :root {
            --bg-color: #0a0e17;
            --card-bg: #131b2e;
            --accent-color: #2563eb;
            --text-color: #ffffff;
            --border-color: #1e293b;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 15px;
            box-sizing: border-box;
        }

        .container {
            background-color: var(--card-bg);
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.6);
            width: 100%;
            max-width: 450px;
            border: 1px solid var(--border-color);
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .header h2 {
            margin: 0;
            font-size: 22px;
            color: #38bdf8;
        }

        .form-group {
            margin-bottom: 12px;
            text-align: right;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-size: 13px;
            color: #94a3b8;
        }

        select, input, button {
            width: 100%;
            padding: 11px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background-color: var(--bg-color);
            color: #fff;
            font-size: 14px;
            box-sizing: border-box;
            outline: none;
        }

        button {
            background-color: var(--accent-color);
            font-weight: bold;
            cursor: pointer;
            border: none;
            margin-top: 8px;
            transition: 0.2s;
        }

        button:hover {
            opacity: 0.9;
        }

        .theme-selector {
            display: flex;
            gap: 8px;
            margin-bottom: 15px;
        }

        .theme-btn {
            padding: 6px;
            font-size: 12px;
            background-color: #1e293b;
        }

        .result-card {
            margin-top: 15px;
            padding: 15px;
            border-radius: 8px;
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            text-align: center;
            display: none;
            line-height: 1.6;
        }

        .alert-box {
            padding: 10px;
            border-radius: 6px;
            font-size: 13px;
            margin-top: 8px;
            display: none;
        }

        .alert-warning { background-color: #7c2d12; color: #fca5a5; }
        .alert-breakout { background-color: #065f46; color: #6ee7b7; }
    </style>
</head>
<body>

<div class="container">

    <!-- 1. قفل بكلمة سر -->
    <div id="loginScreen">
        <div class="header">
            <h2>🔐 دخول بوت التداول</h2>
            <p style="color: #94a3b8; font-size: 13px;">أدخل الرمز الخاص بك للمتابعة</p>
        </div>
        <div class="form-group">
            <input type="password" id="passCode" placeholder="أدخل الرمز هنا">
        </div>
        <button onclick="login()">دخول</button>
        <p id="loginError" style="color: #ef4444; font-size: 12px; display: none; text-align: center; margin-top: 10px;">الرمز غير صحيح!</p>
    </div>

    <!-- واجهة البوت الرئيسية -->
    <div id="botScreen" style="display: none;">
        
        <!-- 9 & 10. تغيير أشكال وألوان البوت ترتيبه من الداخل -->
        <div class="theme-selector">
            <button class="theme-btn" onclick="changeTheme('#0a0e17', '#131b2e', '#2563eb')">داكن 🌙</button>
            <button class="theme-btn" onclick="changeTheme('#062016', '#0b3826', '#10b981')">أخضر 🟢</button>
            <button class="theme-btn" onclick="changeTheme('#1f1924', '#2d2236', '#9333ea')">بنفسجي 🟣</button>
        </div>

        <div class="header">
            <h2>🤖 بوت إكسبيرت أوبشن</h2>
        </div>

        <!-- 2. إضافة كل أسواق إكسبيرت أوبشن -->
        <div class="form-group">
            <label>السوق / الأصل:</label>
            <select id="asset">
                <optgroup label="العملات (Forex)">
                    <option value="EUR/USD">EUR/USD</option>
                    <option value="GBP/USD">GBP/USD</option>
                    <option value="USD/JPY">USD/JPY</option>
                    <option value="AUD/USD">AUD/USD</option>
                    <option value="USD/CAD">USD/CAD</option>
                </optgroup>
                <optgroup label="العملات الرقمية (Crypto)">
                    <option value="BTC/USD">Bitcoin (BTC/USD)</option>
                    <option value="ETH/USD">Ethereum (ETH/USD)</option>
                    <option value="XRP/USD">Ripple (XRP/USD)</option>
                </optgroup>
                <optgroup label="السلع والمعادن">
                    <option value="GOLD">الذهب (GOLD)</option>
                    <option value="SILVER">الفضة (SILVER)</option>
                    <option value="OIL">النفط (OIL)</option>
                </optgroup>
            </select>
        </div>

        <!-- 3. فريمات من 5 ثواني إلى يوم -->
        <div class="form-group">
            <label>فريم التحليل:</label>
            <select id="timeframe">
                <option value="5 ثواني">5 ثواني</option>
                <option value="15 ثانية">15 ثانية</option>
                <option value="30 ثانية">30 ثانية</option>
                <option value="دقيقة واحدة">دقيقة واحدة</option>
                <option value="5 دقائق">5 دقائق</option>
                <option value="15 دقيقة">15 دقيقة</option>
                <option value="ساعة">ساعة واحدة</option>
                <option value="يوم">يوم كامل</option>
            </select>
        </div>

        <!-- 4. زمن الصفقة من 10 ثواني إلى 30 دقيقة -->
        <div class="form-group">
            <label>زمن الصفقة:</label>
            <select id="duration">
                <option value="10 ثواني">10 ثواني</option>
                <option value="30 ثانية">30 ثانية</option>
                <option value="دقيقة واحدة">دقيقة واحدة</option>
                <option value="5 دقائق">5 دقائق</option>
                <option value="15 دقيقة">15 دقيقة</option>
                <option value="30 دقيقة">30 دقيقة</option>
            </select>
        </div>

        <!-- 5. الاستراتيجيات -->
        <div class="form-group">
            <label>الاستراتيجية:</label>
            <select id="strategy">
                <option value="RSI + Stochastic">مؤشر RSI مع Stochastic</option>
                <option value="Bollinger Bands Breakout">اختراق البولينجر باندز</option>
                <option value="Moving Average Crossover">تقاطع المتوسطات المتحركة</option>
                <option value="Price Action Support/Resistance">السلوك السعري (دعوم ومقاومات)</option>
            </select>
        </div>

        <!-- 8. أزرار الشراء والبيع والتحليل -->
        <button onclick="processAnalysis()">تحليل السوق وجلب التوصية</button>
        <button onclick="logout()" style="background-color: #dc2626;">إغلاق البوت 🔒</button>

        <!-- التنبيهات والنتائج (6 & 7) -->
        <div id="volatileAlert" class="alert-box alert-warning">⚠️ تحذير: يوجد تذبذب عالي في السوق الآن! ينصح بإيقاف التداول.</div>
        <div id="breakoutAlert" class="alert-box alert-breakout">🚨 تم كسر مستوى دعم/مقاومة هام على الشارت!</div>

        <div id="resultCard" class="result-card"></div>
    </div>

</div>

<script>
    // 1. تغيير رمز السر هنا
    const myCode = "1234";

    function login() {
        const input = document.getElementById('passCode').value;
        if (input === myCode) {
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('botScreen').style.display = 'block';
            document.getElementById('loginError').style.display = 'none';
            document.getElementById('passCode').value = '';
        } else {
            document.getElementById('loginError').style.display = 'block';
        }
    }

    function logout() {
        document.getElementById('botScreen').style.display = 'none';
        document.getElementById('loginScreen').style.display = 'block';
    }

    // 9 & 10. دالة لتغيير ألوان المظهر من الداخل
    function changeTheme(bg, card, accent) {
        document.documentElement.style.setProperty('--bg-color', bg);
        document.documentElement.style.setProperty('--card-bg', card);
        document.documentElement.style.setProperty('--accent-color', accent);
    }

    // 6, 7, 8. دالة التحليل وإصدار التوصيات والتنبيهات
    function processAnalysis() {
        const asset = document.getElementById('asset').value;
        const timeframe = document.getElementById('timeframe').value;
        const duration = document.getElementById('duration').value;
        const strategy = document.getElementById('strategy').value;

        const vAlert = document.getElementById('volatileAlert');
        const bAlert = document.getElementById('breakoutAlert');
        const resCard = document.getElementById('resultCard');

        vAlert.style.display = 'none';
        bAlert.style.display = 'none';
        resCard.style.display = 'none';

        // محاكاة حالة السوق
        const states = ['normal', 'volatile', 'breakout'];
        const currentState = states[Math.floor(Math.random() * states.length)];

        if (currentState === 'volatile') {
            // 6. التذبذب
            vAlert.style.display = 'block';
        } else if (currentState === 'breakout') {
            // 7. الكسر
            bAlert.style.display = 'block';
            const signal = Math.random() > 0.5 ? 'شراء (CALL) 🟢' : 'بيع (PUT) 🔴';
            resCard.style.display = 'block';
            resCard.innerHTML = `<b>توصية كسر المستوى:</b><br>الأصل: ${asset}<br>التوصية: ${signal}<br>مدة الصفقة: ${duration}`;
        } else {
            // 8. بيع وشراء عادية
            const signal = Math.random() > 0.5 ? 'شراء (CALL) 🟢' : 'بيع (PUT) 🔴';
            resCard.style.display = 'block';
            resCard.innerHTML = `<b>إشارة تداول جديدة:</b><br>الأصل: ${asset} (${timeframe})<br>الاستراتيجية: ${strategy}<br>التوصية: <b>${signal}</b><br>مدة الصفقة: ${duration}`;
        }
    }
</script>

</body>
</html>
