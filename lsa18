<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#07111d">
<title>البوت الخاص</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Tahoma,Arial,sans-serif;background:#06111c;color:#eef7f5}
body{
  background:
    radial-gradient(circle at 50% 20%,rgba(0,220,145,.10),transparent 28%),
    radial-gradient(circle at 100% 60%,rgba(0,120,255,.08),transparent 35%),
    #06111c;
}
.app{width:min(100%,620px);margin:auto;padding:18px 18px 28px}
.top{display:flex;align-items:center;justify-content:space-between;color:#b9c4ce;font-size:26px}
.menu{width:45px;text-align:center;letter-spacing:4px}
.code{font-size:27px;direction:ltr}
.logo{
  width:142px;height:142px;margin:16px auto 10px;border-radius:34px;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(145deg,#08df9a,#05b878);
  box-shadow:0 0 45px rgba(0,224,150,.20);
}
.crown{font-size:68px;filter:drop-shadow(0 3px 2px rgba(0,0,0,.3))}
.badge{
  width:max-content;margin:0 auto 26px;padding:9px 20px;border-radius:22px;
  background:rgba(0,220,145,.12);border:1px solid rgba(0,220,145,.28);
  color:#2ee7ad;font-size:14px;font-weight:bold
}
.hero{text-align:center;margin-bottom:20px}
.hero h1{font-size:28px;margin:0 0 8px}
.hero h1 span{color:#18d998}
.sub{font-size:15px;color:#d7dee4}
.sub b{color:#20dca4}
.card{
  background:linear-gradient(160deg,rgba(20,31,52,.95),rgba(9,18,34,.98));
  border:1px solid rgba(255,255,255,.035);
  border-radius:24px;padding:17px;box-shadow:0 16px 45px rgba(0,0,0,.28)
}
.label{font-size:15px;font-weight:bold;margin:0 4px 8px}
.input-wrap{position:relative;margin-bottom:14px}
input{
  width:100%;height:64px;border:1px solid rgba(255,255,255,.04);outline:none;
  border-radius:17px;background:#080f21;color:#fff;padding:0 54px 0 18px;
  font-size:16px;text-align:right
}
input::placeholder{color:#77808f}
.key{
  position:absolute;right:12px;top:11px;width:43px;height:43px;border-radius:13px;
  background:rgba(0,220,145,.12);display:flex;align-items:center;justify-content:center;
  font-size:23px
}
.lock{position:absolute;right:18px;top:20px;color:#596274;font-size:19px}
.password{padding-right:54px}
.hint{font-size:12px;color:#77818f;margin:-8px 5px 14px}
button{
  border:0;cursor:pointer;font-family:inherit;color:#fff
}
.login{
  width:100%;height:62px;border-radius:18px;background:linear-gradient(135deg,#05df96,#0acb8a);
  color:#03140f;font-size:18px;font-weight:bold;box-shadow:0 10px 25px rgba(0,220,145,.15)
}
.login:active{transform:scale(.99)}
.options{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:16px}
.opt{
  height:58px;border-radius:15px;background:#080f21;color:#cbd3dc;
  font-size:15px;border:1px solid transparent
}
.opt.active{border-color:rgba(0,220,145,.25);color:#31e5af}
.copy{text-align:center;color:#7c8593;font-size:12px;margin:18px 0}
.stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.stat{background:#080f21;border-radius:16px;padding:17px 8px;text-align:center}
.num{font-size:20px;font-weight:bold;margin-bottom:6px}
.green{color:#2de4ae}
.small{font-size:12px;color:#9aa3ae}
.info{
  margin-top:16px;padding:18px;border-radius:17px;background:rgba(5,16,30,.7);
  border:1px solid rgba(255,255,255,.03);color:#8f9aa7;font-size:13px;line-height:1.9;text-align:center
}
.shield{color:#35e5b0;font-size:20px}
.status{display:inline-flex;align-items:center;gap:7px;margin-top:12px;color:#35e5b0;font-size:12px}
.dot{width:8px;height:8px;background:#20df9f;border-radius:50%;box-shadow:0 0 10px #20df9f}
.toast{
  position:fixed;left:18px;right:18px;bottom:20px;margin:auto;max-width:580px;
  padding:14px 18px;border-radius:14px;background:#121d30;border:1px solid #24324a;
  text-align:center;opacity:0;transform:translateY(15px);transition:.25s;pointer-events:none
}
.toast.show{opacity:1;transform:translateY(0)}
@media(max-width:390px){
 .app{padding:14px 12px 22px}.logo{width:120px;height:120px}.hero h1{font-size:24px}
 .options,.stats{gap:8px}.stat{padding:14px 5px}
}
</style>
</head>
<body>
<div class="app">
  <div class="top"><div class="menu">•••</div><div class="code">&lt;/&gt;</div></div>

  <div class="logo"><div class="crown">♛</div></div>
  <div class="badge">✦ نسخة خاصة • PRIVATE EDITION</div>

  <section class="hero">
    <h1>مرحباً بالشاعر<br><span>عسعوسي</span></h1>
    <div class="sub">البوت الخاص بك • <b>al.sa3usi</b> • محلل Smarty الخاص</div>
  </section>

  <div class="card">
    <div class="label">أدخل الرمز الخاص بك</div>
    <div class="input-wrap">
      <div class="key">🔑</div>
      <input id="token" type="text" placeholder="الرمز أساسك • يعمل فوراً • بدون إنترنت">
    </div>

    <div class="input-wrap">
      <div class="lock">♧</div>
      <input id="password" class="password" type="password" placeholder="اكتب: عسعوسي">
    </div>

    <div class="hint">🔒 الرمز محفوظ محلياً في هذا الجهاز فقط</div>

    <button class="login" onclick="activateBot()">🔒 تفعيل البوت الخاص - دخول</button>

    <div class="options">
      <button class="opt" onclick="setMode(this,'EN')">✦<br>EN</button>
      <button class="opt active" onclick="setMode(this,'الكامل')">⌁<br>الكامل</button>
      <button class="opt" onclick="setMode(this,'الأساسي')">♛<br>الأساسي</button>
    </div>

    <div class="copy" onclick="copyDemo()">نسخ الرمز الافتراضي ⧉</div>

    <div class="stats">
      <div class="stat"><div class="num">68</div><div class="small">سوق</div></div>
      <div class="stat"><div class="num green">Smarty</div><div class="small">محلل خاص</div></div>
      <div class="stat"><div class="num">∞</div><div class="small">مدى الحياة</div></div>
    </div>

    <div class="info">
      <div class="shield">♢</div>
      هذا البوت خاص بالمستخدم • محلل Smarty خاص • فلاتر ذكية •
      حساسية قابلة للتحكم • يعمل Offline
      <div class="status"><span class="dot"></span><span id="status">جاهز للتشغيل</span></div>
    </div>
  </div>
</div>

<div id="toast" class="toast"></div>

<script>
const SECRET_CODE="142905";
const DEMO_TOKEN=SECRET_CODE;

function toast(msg){
  const t=document.getElementById("toast");
  t.textContent=msg;t.classList.add("show");
  clearTimeout(window.toastTimer);
  window.toastTimer=setTimeout(()=>t.classList.remove("show"),2200);
}
function activateBot(){
  const token=document.getElementById("token").value.trim();
  if(!token){toast("أدخل الرمز الخاص أولاً");return}
  if(token!==SECRET_CODE){
    toast("الرمز غير صحيح");
    return;
  }
  localStorage.setItem("botToken",token);
  document.getElementById("status").textContent="البوت مفعّل محلياً";
  toast("تم التفعيل بنجاح — وضع Offline");
}
function setMode(el,mode){
  document.querySelectorAll(".opt").forEach(x=>x.classList.remove("active"));
  el.classList.add("active");
  localStorage.setItem("botMode",mode);
  toast("تم اختيار وضع: "+mode);
}
function copyDemo(){
  navigator.clipboard?.writeText(DEMO_TOKEN).then(()=>toast("تم نسخ الرمز الافتراضي"))
  .catch(()=>toast("الرمز الافتراضي: "+DEMO_TOKEN));
}
window.addEventListener("load",()=>{
  const saved=localStorage.getItem("botToken");
  if(saved) document.getElementById("token").value=saved;
});
</script>
</body>
</html>
